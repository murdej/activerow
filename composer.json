{
    "name": "murdej/activerow",
    "description": "Murdej active row",
    "autoload": {
        "psr-4": {
            "Murdej\\ActiveRow\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Vít Peprníček",
            "email": "vit.peprnicek@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "murdej/query-maker-php": "^1.0",
        "nette/utils": "^4.1"
    },
    "suggest": {
        "nette/database": "For use Nette Database",
        "symfony/console": "For use Murdej\\ActiveRow\\Bridges\\MakeMigrateCommand",
        "nette/caching": "For use Murdej\\ActiveRow\\Bridges\\NetteCache"
    },

    "minimum-stability": "stable",
    "require-dev": {
        "nette/database": "^3.2",
        "symfony/console": "^7.0",
        "nette/caching": "^3.2"
    }
}
